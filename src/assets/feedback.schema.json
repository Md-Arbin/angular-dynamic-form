{
  "title": "Product Feedback",
  "fields": [
    {"label":"Name","name":"name","type":"text"},
    {"label":"Email","name":"email","type":"text","validation":{"pattern":"^[a-zA-Z0-9+_.-]+@[a-zA-Z0-9.-]+$","message":"Provide a valid email"}},
    {"label":"Rating","name":"rating","type":"dropdown","options":["1","2","3","4","5"],"required":true},
    {"label":"Improvements","name":"improvements","type":"multiselect","options":["UI","Performance","Docs","Features"]},
    {"label":"Notify me","name":"notify","type":"checkbox"},
    {"label":"Comments","name":"comments","type":"textarea"}
  ]
}
